// ru.yurasov.sysmetrics: defaultuser darf genau
// ru.yurasov.sysmetrics-helper.service starten/stoppen, sonst nichts.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "ru.yurasov.sysmetrics-helper.service" &&
        subject.user == "defaultuser") {
        return polkit.Result.YES;
    }
});
